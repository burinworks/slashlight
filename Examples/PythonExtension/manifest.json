{
  "id": "uuid",
  "title": "UUID Generator",
  "subtitle": "Example extension written in Python",
  "icon": "sf:number",
  "version": "1.0",
  "triggers": ["commands", "command:uuid"],
  "exec": ["/usr/bin/env", "python3", "extension.py"],
  "hotkeys": [
    { "id": "paste-new", "title": "Paste a new UUID", "scope": "global", "default": "ctrl+opt+u" }
  ]
}
