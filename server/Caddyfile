# No `log` directive: Caddy keeps no access log, so IP addresses are never written to disk.
{$DOMAIN} {
	encode zstd gzip
	header {
		-Server
		Referrer-Policy no-referrer
		X-Content-Type-Options nosniff
	}
	handle /v1/* {
		reverse_proxy collector:8080
	}
	handle {
		root * /srv
		header /stats.json Cache-Control "public, max-age=300"
		file_server
	}
}
